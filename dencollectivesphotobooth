      paintSticker(c.getContext('2d'), p.icon, 44, 44, 31, { fill: p.lineart ? '#FFD3B0' : (p.colors || STICKER_COLORS[p.icon])[0], ink: p.mono ? '#16181D' : undefined, wash: p.lineart, rot: 0 });
