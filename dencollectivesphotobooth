  function getTemplate(id) { return CONFIG.templates.find((t) => t.id === id) || CONFIG.templates[0]; }

  /** Everything the strip drawing depends on. renderStrip(canvas, dpi, overrides) can swap parts (used for previews). */
  function currentView() {
    return {
      layout: currentLayout(), tpl: state.templateId, color: state.stripColor, frame: state.frameColor,
      bg: state.templateId === 'plain' ? null : state.bgCanvas,
      photos: state.photos, filterId: state.filterId, showDate: state.showDate, text: state.customText,
      stickers: state.stickers, tplText: state.tplText,
    };
  }

  /** Assemble the whole strip on a canvas at the requested dpi. */
  function renderStrip(canvas, dpi, overrides) {
    const v = Object.assign(currentView(), overrides || {});
    const layout = v.layout, g = geometry(layout, dpi), px = (n) => n * dpi, tpl = getTemplate(v.tpl);
    if (tpl.lockBg) { v.bg = null; v.color = tpl.bg; v.frame = tpl.frame; }          // locked-background templates ignore color / photo choices
    canvas.width = g.W; canvas.height = g.H;
    const ctx = canvas.getContext('2d');
    ctx.imageSmoothingQuality = 'high';
    ctx.fillStyle = v.color; ctx.fillRect(0, 0, g.W, g.H);
    if (v.bg) {                                   // gallery photo behind the frames (templates only)
      drawCover(ctx, v.bg, v.bg.width, v.bg.height, 0, 0, g.W, g.H, false);
      ctx.fillStyle = withAlpha(v.color, 0.4); ctx.fillRect(0, 0, g.W, g.H);
    }
    const ink = inkFor(v.color);
    const frame = v.frame || tpl.frame || ink;
    const accent = tpl.accent === 'frame' ? frame : ink;

    const P = PAINT[tpl.paint], C = { px, ink, frame, accent, pInk: inkFor(frame) };

    // border / decoration
    if (P) P.back(ctx, g, v, dpi, C);
    else if (tpl.deco === 'none') {
      const k = px(0.05);
      ctx.strokeStyle = withAlpha(ink, 0.22); ctx.lineWidth = Math.max(1, px(0.012));
      ctx.strokeRect(k, k, g.W - 2 * k, g.H - 2 * k);
    } else if (tpl.deco === 'double') {
      ctx.strokeStyle = frame; ctx.lineWidth = Math.max(1, px(0.009));
      [0.04, 0.075].forEach((i) => ctx.strokeRect(px(i), px(i), g.W - 2 * px(i), g.H - 2 * px(i)));
    } else if (tpl.deco === 'single') {
      ctx.strokeStyle = frame; ctx.lineWidth = Math.max(1, px(0.012));
      ctx.strokeRect(px(0.06), px(0.06), g.W - px(0.12), g.H - px(0.12));
    } else if (tpl.deco === 'scallop') {
      drawScallop(ctx, px(0.055), g.frames[0].y - px(0.09), g.W - px(0.055), g.bottomY + px(0.09), px(0.04), frame);
    }

    // photos
    const filter = getFilter(v.filterId);
    const shape = (f) => {
      ctx.beginPath();
      if (tpl.shape === 'oval') ctx.ellipse(f.x + f.w / 2, f.y + f.h / 2, f.w / 2, f.h / 2, 0, 0, Math.PI * 2);
      else if (tpl.shape === 'round') rr(ctx, f.x, f.y, f.w, f.h, px(tpl.rad || 0.09));
      else ctx.rect(f.x, f.y, f.w, f.h);
    };
    (tpl.art ? [] : g.frames).forEach((f, i) => {
      const p = v.photos[i];
      ctx.save(); shape(f); ctx.clip();
      if (p) ctx.drawImage(filteredPhoto(p, f.w, f.h, filter), f.x, f.y);
      else { ctx.fillStyle = tpl.ph || withAlpha(ink, 0.12); ctx.fillRect(f.x, f.y, f.w, f.h); }
      ctx.restore();
      ctx.strokeStyle = tpl.line === 'frame' ? frame : tpl.line === 'ink' ? SK : withAlpha(ink, 0.4); ctx.lineWidth = Math.max(1, px(tpl.lw || 0.01));
