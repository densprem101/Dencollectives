      if (img) ctx.drawImage(img, 0, 0, g.W, g.H);
      // small pasted label for the fixed brand line (always "Den Collectives"), the date and the user's words
      const tx = (v.text || '').trim(), date = v.showDate ? formatDate() : '';
      const box = four ? { x: px(0.27), y: g.H - px(0.222), w: px(0.93), h: px(0.19) } : { x: px(0.3), y: g.H - px(0.89), w: px(1.4), h: px(0.47) };
      ctx.save();
