          </div>
        </fieldset>

        <fieldset>
          <legend class="label" data-text="filterLegend"></legend>
          <div class="filter-chips" id="filterChips"></div>
        </fieldset>

        <fieldset id="colorField">
          <legend class="label" data-text="colorLegend"></legend>
          <div class="swatches" id="swatches"></div>
        </fieldset>

        <fieldset id="frameField" hidden>
          <legend class="label" data-text="frameLegend"></legend>
          <div class="swatches" id="frameSwatches"></div>
        </fieldset>

        <fieldset id="bgField" hidden>
          <legend class="label" data-text="bgLegend"></legend>
          <div class="bg-row">
            <button class="btn btn--quiet" type="button" id="bgChoose">
              <svg class="icon" aria-hidden="true"><use href="#i-image" /></svg><span data-text="bgChoose"></span>
