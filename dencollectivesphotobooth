/* --------------------------------------------------------------------------
   Landing micro-animations: metronome strips + gentle breeze curtain
   Easy-edit knobs: --tick-angle, --tick-ms, --tick-pivot-y, --breeze-ms
   -------------------------------------------------------------------------- */
.booth { --tick-angle: 1.5deg; --tick-ms: 3800ms; --tick-pivot-y: 46%; --breeze-ms: 9s; }
