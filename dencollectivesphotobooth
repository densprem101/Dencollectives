  <!-- ====================== 2. SETUP ====================== -->
  <section class="screen" id="screen-setup" data-screen="setup" hidden aria-labelledby="setupTitle">
    <h1 class="title" id="setupTitle" data-text="setupTitle"></h1>
    <p class="lede" data-text="setupLede"></p>

    <form class="panel" id="setupForm" novalidate>
      <fieldset>
        <legend class="label" data-text="stripSizeLegend"></legend>
        <div class="choices" id="layoutChoices"><!-- filled from CONFIG.layouts --></div>
      </fieldset>

      <fieldset>
        <legend class="label" data-text="delayLegend"></legend>
        <div class="chips" id="delayChips"><!-- filled from CONFIG.timer --></div>
        <p class="help" data-text="delayHelp"></p>
      </fieldset>

      <div class="setup-actions">
        <button class="btn btn--quiet" type="button" id="setupBack">
          <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg><span data-text="back"></span>
        </button>
        <button class="btn btn--primary" type="submit" id="proceedBtn">
          <svg class="icon" aria-hidden="true"><use href="#i-camera" /></svg><span data-text="proceed"></span>
        </button>
      </div>
    </form>
  </section>

  <!-- ====================== 3. CAPTURE ====================== -->
  <section class="screen" id="screen-capture" data-screen="capture" hidden aria-labelledby="captureTitle">
    <h1 class="title" id="captureTitle" data-text="captureTitle"></h1>

    <div class="capture-grid" id="captureGrid">
      <div class="stage">
        <div class="frame" id="frame">
          <div class="note-eye hand" aria-hidden="true">
            <span data-text="eyeLevel"></span>
            <svg viewBox="0 0 48 26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14c12-5 24-5 41-1" /><path d="M35 5.5l9 7.5-9.5 7" /></svg>
          </div>
          <div class="viewfinder is-idle" id="viewfinder">
            <video id="video" playsinline muted autoplay></video>
            <div class="cam-msg" id="camMsg" hidden>
              <p id="camMsgText"></p>
              <div class="btn-row">
                <button class="btn" type="button" id="camRetry"><span data-text="tryAgain"></span></button>
                <button class="btn" type="button" id="camUpload">
                  <svg class="icon" aria-hidden="true"><use href="#i-image" /></svg><span data-text="usePhotos"></span>
                </button>
              </div>
            </div>
            <div class="count" id="count" aria-hidden="true"></div>
            <div class="flash" id="flash"></div>
            <span class="live-badge" aria-hidden="true"><i></i><b data-text="live"></b></span>
            <button class="cam-zoom" type="button" id="camZoom" hidden aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-cam-out" /></svg></button>
          </div>
        </div>

        <p class="pose-label label" id="poseLabel" role="status" aria-live="polite"></p>

        <div class="btn-row">
          <button class="btn" type="button" id="captureBack">
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg><span data-text="back"></span>
          </button>
          <button class="btn btn--primary" type="button" id="captureBtn">
            <svg class="icon" aria-hidden="true"><use href="#i-camera" /></svg><span id="captureBtnText" data-text="capture"></span>
          </button>
          <button class="btn btn--quiet" type="button" id="cancelBtn" hidden><span data-text="cancel"></span></button>
          <button class="btn" type="button" id="toEditBtn" hidden>
            <span data-text="toEdit"></span><svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
          </button>
        </div>
      </div>

      <ol class="slots" id="slots" aria-label="Your photos"><!-- thumbnails --></ol>
    </div>
    <input type="file" id="fileInput" accept="image/*" hidden />
  </section>

  <!-- ====================== 4. EDIT ====================== -->
  <section class="screen" id="screen-edit" data-screen="edit" hidden aria-labelledby="editTitle">
    <h1 class="title" id="editTitle" data-text="editTitle"></h1>

    <div class="edit-grid">
      <div class="edit-left">
        <div class="preview-wrap">
          <div class="preview-card"><canvas id="stripPreview" aria-label="Live preview of your photo strip" role="img"></canvas></div>
        </div>

        <div class="edit-below">
          <div class="text-field" id="textField" hidden>
            <label class="label" for="customText" data-text="customTextLabel"></label>
            <input type="text" id="customText" autocomplete="off" />
            <p class="help" data-text="customTextHelp"></p>
          </div>

          <div class="text-field" id="tplTextField" hidden>
            <label class="label" for="tplText" data-text="tplTextLabel"></label>
            <input type="text" id="tplText" autocomplete="off" />
            <p class="help" data-text="tplTextHelp"></p>
          </div>

          <div class="btn-row" style="justify-content:flex-start">
            <button class="btn" type="button" id="editBack">
              <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg><span data-text="backToCamera"></span>
