  /** Scatter a fresh random set of themed stickers over the strip (never touches photo centers or the text). */
  function generateStickers(packId) {
    const SK = CONFIG.stickers, pack = SK.packs.find((p) => p.id === packId) || SK.packs[0];
    const mixPacks = SK.packs.filter((p) => p.glyphs && !p.mono);
    const pickGlyph = () => { const p = pack.glyphs ? pack : mixPacks[Math.floor(Math.random() * mixPacks.length)]; return { g: p.glyphs[Math.floor(Math.random() * p.glyphs.length)], p }; };
    const g = geometry(currentLayout(), 100);
    const ratio = g.H / g.W;
    const rnd = (a, b) => a + Math.random() * (b - a);
    for (let attempt = 0; attempt < 8; attempt++) {
      const n = Math.round(rnd(SK.countMin, SK.countMax));
      const placed = [];
      const ok = (x, y, size) => {
        if (x < 0.04 || x > 0.96 || y < 0.02 || y > 0.98) return false;
        const px = x * g.W, py = y * g.H, pr = size * g.W * 0.42;
        for (const f of g.frames) {                       // keep photo faces clear: only edges/corners may be covered
          const ix = f.w * 0.22, iy = f.h * 0.16;
          if (px > f.x + ix - pr * 0.3 && px < f.x + f.w - ix + pr * 0.3 && py > f.y + iy - pr * 0.3 && py < f.y + f.h - iy + pr * 0.3) return false;
        }
        const top = g.frames[0].y;
        if (py < top && Math.abs(x - 0.5) < 0.3) return false;                    // DEN COLLECTIVES header
        if (py > g.bottomY && Math.abs(x - 0.5) < 0.27) return false;             // date / custom text
        return true;
      };
      for (let i = 0; i < n; i++) {
        let best = null, bestD = -1;
        for (let k = 0; k < 40; k++) {                      // best-candidate sampling = even, natural spread
          const size = rnd(SK.sizeMin, SK.sizeMax), x = rnd(0.05, 0.95), y = rnd(0.03, 0.97);
          if (!ok(x, y, size)) continue;
          let d = 9;
          placed.forEach((q) => { d = Math.min(d, Math.hypot(x - q.x, (y - q.y) * ratio) - (size + q.size) * 0.6); });
          if (d > bestD) { bestD = d; best = { x, y, size }; }
        }
        if (!best || bestD < 0.02) continue;
        const { g: glyph, p: gp } = pickGlyph();
        const opts = (pack.glyphs ? pack.colors : null) || STICKER_COLORS[glyph];
        let fill = opts[Math.floor(Math.random() * opts.length)];
        if (pack.mono && glyph === 'eightball') fill = '#16181D';
        placed.push(Object.assign(best, {
          id: ++state.stickerSeq, glyph, fill, ink: pack.mono ? (fill === '#16181D' ? '#F4F1EA' : '#16181D') : undefined,
          wash: !!(pack.glyphs && pack.lineart), seed: Math.random() * 1000, rot: rnd(-0.4, 0.4),
        }));
      }
      const sig = placed.map((p) => `${p.glyph}${p.fill}${p.x.toFixed(3)}${p.y.toFixed(3)}`).join('|');
      if (placed.length >= 4 && !usedSignatures.has(sig)) { usedSignatures.add(sig); return placed; }
    }
    return [];
  }

