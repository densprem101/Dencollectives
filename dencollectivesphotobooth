      ctx.lineWidth = Math.max(1, px(0.007)); ctx.strokeStyle = VT_INK; ctx.beginPath(); rr(ctx, box.x + px(0.012), box.y + px(0.012), box.w - px(0.024), box.h - px(0.024), px(0.012)); ctx.stroke();
      const BR = 'Den Collectives', cx = box.x + box.w / 2, mw = box.w - px(0.09);
      const lines = [];
      lines.push({ s: BR, z: four ? px(0.075) : px(0.12), f: (z) => `italic 700 ${z}px ${F.brand}` });
      if (!four && tx) lines.push({ s: tx, z: px(0.16), f: (z) => `600 ${z}px ${F.caption}` });
      if (four && (tx || date)) lines.push({ s: [tx, date].filter(Boolean).join('  ·  '), z: px(0.05), f: (z) => `400 ${z}px ${F.date}` });
      if (!four && date) lines.push({ s: date, z: px(0.062), f: (z) => `400 ${z}px ${F.date}` });
