    const mono = st.ink !== undefined;
    const mc = (h) => { if (!mono) return h; const l = hexLuma(h); return l < 100 ? '#16181D' : l < 190 ? '#8A8D94' : '#FFFFFF'; };
    const fillP = (fn, col) => { ctx.fillStyle = mc(col); path(fn); ctx.fill(); };
    const dot = (x, y, r, col) => fillP((c) => { c.moveTo(x + r, y); c.arc(x, y, r, 0, Math.PI * 2); }, col);
    if (FILL_DETAIL[kind] && gl.detail) fillP(gl.detail, FILL_DETAIL[kind]);
    switch (kind) {
      case 'flower': case 'corsage': dot(0, 0, kind === 'flower' ? 0.2 : 0.14, '#F6C945'); break;
      case 'balloon': fillP((c) => { c.ellipse(-0.3, -0.5, 0.09, 0.2, 0.4, 0, Math.PI * 2); }, '#FFFFFF'); ctx.globalAlpha = 1; break;
      case 'cake':
        fillP((c) => c.rect(-0.8, 0.1, 1.6, 0.8), '#F2DDB8');
        dot(0, -0.68, 0.1, '#E8575A'); break;
      case 'gift': fillP((c) => c.rect(-0.11, -0.4, 0.22, 1.25), '#F6C945'); break;
      case 'cupcake': fillP((c) => { c.moveTo(-0.6, 0.15); c.lineTo(-0.45, 0.9); c.lineTo(0.45, 0.9); c.lineTo(0.6, 0.15); c.closePath(); }, '#D9A066'); break;
      case 'candle': fillP((c) => { c.moveTo(0, -0.95); c.bezierCurveTo(0.3, -0.6, 0.2, -0.3, 0, -0.3); c.bezierCurveTo(-0.2, -0.3, -0.3, -0.6, 0, -0.95); }, '#F59E3F'); break;
      case 'bunting':
        fillP((c) => { c.moveTo(-0.8, -0.5); c.lineTo(-0.3, -0.5); c.lineTo(-0.55, 0.3); c.closePath(); }, '#E8575A');
        fillP((c) => { c.moveTo(-0.25, -0.5); c.lineTo(0.25, -0.5); c.lineTo(0, 0.4); c.closePath(); }, '#F6C945');
        fillP((c) => { c.moveTo(0.3, -0.5); c.lineTo(0.8, -0.5); c.lineTo(0.55, 0.3); c.closePath(); }, '#8FC9E8'); break;
      case 'rose': fillP((c) => { c.moveTo(0, 0.65); c.quadraticCurveTo(0.55, 0.35, 0.6, 0.75); c.quadraticCurveTo(0.2, 0.9, 0, 0.65); }, '#6DB784'); break;
      case 'bigben': dot(0, 0.05, 0.17, '#FFFFFF'); break;
      case 'globe':
        fillP((c) => c.ellipse(-0.3, -0.2, 0.22, 0.3, 0.4, 0, Math.PI * 2), '#7DC48B');
        fillP((c) => c.ellipse(0.3, 0.28, 0.25, 0.2, -0.3, 0, Math.PI * 2), '#7DC48B'); break;
      case 'rocket': {
        const fc = st.fill === '#E8575A' ? '#3F7FBF' : '#E8575A';
        fillP((c) => { c.moveTo(0.35, 0.2); c.lineTo(0.75, 0.75); c.lineTo(0.35, 0.6); c.closePath(); c.moveTo(-0.35, 0.2); c.lineTo(-0.75, 0.75); c.lineTo(-0.35, 0.6); c.closePath(); }, fc);
        dot(0, -0.25, 0.17, '#8FC9E8'); break;
      }
      case 'astronaut': fillP((c) => c.ellipse(0, -0.35, 0.33, 0.25, 0, 0, Math.PI * 2), '#3B4A6B'); break;
      case 'saturn': ctx.strokeStyle = mc('#E8895A'); ctx.lineWidth = 0.1; path((c) => c.ellipse(0, 0, 1, 0.3, -0.45, 0, Math.PI * 2)); ctx.stroke(); break;
      case 'sun': ctx.strokeStyle = mc('#F2A93B'); ctx.lineWidth = 0.1; path(gl.detail); ctx.stroke(); break;
      case 'comet':
        ctx.strokeStyle = mc('#BFDDF2'); ctx.lineWidth = 0.13; path(gl.detail); ctx.stroke();
        ctx.fillStyle = st.fill; path(body); ctx.fill(); break;
      case 'ufo': fillP((c) => { c.moveTo(-0.45, 0); c.bezierCurveTo(-0.4, -0.75, 0.4, -0.75, 0.45, 0); c.closePath(); }, '#CDEBFA'); break;
      case 'vinyl': dot(0, 0, 0.3, '#E8575A'); break;
      default: break;
    }
  }

  /** Paint one sticker. st: glyph, fill, ink (mono packs), wash (line-art packs), rot. */
  function paintSticker(ctx, kind, cx, cy, r, st) {
    const gl = GLYPHS[kind];
    const body = typeof gl === 'function' ? gl : gl.body;
    const path = (fn) => { ctx.beginPath(); fn(ctx); };
    const INK = '#23262F';
    ctx.save();
    ctx.translate(cx, cy);
    if (st.rot) ctx.rotate(st.rot);
    const px = r;
    ctx.scale(r, r);
    ctx.lineJoin = 'round'; ctx.lineCap = 'round';

    // 1. white die-cut edge + soft shadow
    ctx.save();
    ctx.shadowColor = 'rgba(30,24,20,0.30)'; ctx.shadowBlur = px * 0.18; ctx.shadowOffsetY = px * 0.06;
    ctx.fillStyle = '#FFFFFF'; ctx.strokeStyle = '#FFFFFF'; ctx.lineWidth = 0.22;
    path(body); ctx.fill(); ctx.stroke();
    if (gl.detail) { path(gl.detail); ctx.stroke(); }
    ctx.restore();

    if (st.wash) {
      // line-art: pastel block nudged off a clean ink line
      ctx.save(); ctx.translate(0.09, 0.09); ctx.fillStyle = st.fill; path(body); ctx.fill(); ctx.restore();
      ctx.strokeStyle = INK; ctx.lineWidth = 0.07; path(body); ctx.stroke();
      if (gl.detail) { ctx.lineWidth = 0.06; path(gl.detail); ctx.stroke(); }
    } else {
      // 2. flat color
      ctx.fillStyle = st.fill; path(body); ctx.fill();
      paintExtras(ctx, kind, st, path, body, gl);
      const dark = hexLuma(st.fill) < 120, white = hexLuma(st.fill) > 235;
      if (st.ink && white) { ctx.strokeStyle = st.ink; ctx.lineWidth = 0.05; path(body); ctx.stroke(); }
      // 3. subtle detail marks: a deeper tone of the sticker's own color (white on dark ones)
      const det = st.ink && !dark ? st.ink : dark ? 'rgba(255,255,255,0.85)' : shade(st.fill, 0.38);
      if (kind === 'eightball') {                       // white number disc
        ctx.fillStyle = dark ? '#FFFFFF' : '#16181D'; ctx.beginPath(); ctx.arc(0, -0.05, 0.38, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = dark ? '#16181D' : '#FFFFFF'; ctx.lineWidth = 0.07;
        ctx.beginPath(); ctx.arc(0, -0.2, 0.1, 0, Math.PI * 2); ctx.moveTo(0.14, 0.05); ctx.arc(0, 0.05, 0.14, 0, Math.PI * 2); ctx.stroke();
      } else if (gl.detail) {
        ctx.strokeStyle = det; ctx.lineWidth = 0.045; path(gl.detail); ctx.stroke();
      }
      // 4. glossy printed-vinyl sheen
      ctx.save(); path(body); ctx.clip();
      const gr = ctx.createLinearGradient(-0.8, -0.9, 0.6, 0.9);
      gr.addColorStop(0, 'rgba(255,255,255,0.40)'); gr.addColorStop(0.45, 'rgba(255,255,255,0)'); gr.addColorStop(1, 'rgba(0,0,0,0.10)');
      ctx.fillStyle = gr; ctx.fillRect(-1.6, -1.6, 3.2, 3.2); ctx.restore();
    }
    ctx.restore();
  }

  function drawSticker(ctx, st, W, H) {
    paintSticker(ctx, st.glyph, st.x * W, st.y * H, (st.size * W) / 2 * 0.9, st);
  }

  function trackedWidth(ctx, text, tr) {
    let w = 0, n = 0;
    for (const ch of text) { w += ctx.measureText(ch).width; n++; }
    return w + tr * (n - 1);
  }
  function drawTracked(ctx, text, cx, y, tr) {
    const total = trackedWidth(ctx, text, tr);
    let x = cx - total / 2;
    ctx.textAlign = 'left';
    for (const ch of text) { ctx.fillText(ch, x, y); x += ctx.measureText(ch).width + tr; }
    return total;
  }

  function drawIcon(ctx, ic, cx, cy, r, color) {
    drawGlyph(ctx, ic.glyph, cx, cy, r, ic.fill ? { fill: color, stroke: color, lw: Math.max(1, r * 0.12) } : { stroke: color, lw: Math.max(1, r * 0.16) });
  }

  /** Scalloped (wavy) rectangle: a filled rect with circles along its edge. */
  function drawScallop(ctx, x0, y0, x1, y1, r, color) {
    ctx.fillStyle = color;
    ctx.fillRect(x0, y0, x1 - x0, y1 - y0);
    const step = r * 1.7, nx = Math.max(2, Math.round((x1 - x0) / step)), ny = Math.max(2, Math.round((y1 - y0) / step));
    const sx = (x1 - x0) / nx, sy = (y1 - y0) / ny;
    ctx.beginPath();
    const dot = (x, y) => { ctx.moveTo(x + r, y); ctx.arc(x, y, r, 0, Math.PI * 2); };
    for (let i = 0; i <= nx; i++) { dot(x0 + i * sx, y0); dot(x0 + i * sx, y1); }
    for (let k = 0; k <= ny; k++) { dot(x0, y0 + k * sy); dot(x1, y0 + k * sy); }
    ctx.fill();
  }

  /** Fixed "DEN COLLECTIVES" header. Always drawn on every strip; there is no setting to hide it. */
  function drawHeader(ctx, g, v, dpi, ink, accent) {
    const S = CONFIG.strip, px = (n) => n * dpi, tpl = getTemplate(v.tpl);
    const size = px(S.sizesIn.brand), tr = px(S.brandTracking), hasIcon = !!tpl.icon;
    const base = px(hasIcon ? 0.325 : 0.3);
    ctx.save();
    ctx.fillStyle = ink; ctx.textBaseline = 'alphabetic';
    ctx.font = `500 ${size}px ${S.fonts.brand}`;
    const w = drawTracked(ctx, S.brandText, g.W / 2, base, tr);
    if (hasIcon) drawIcon(ctx, tpl.icon, g.W / 2, px(0.135), px(0.05), accent);
    if (tpl.sideLines) {
      const y = base - size * 0.33;
      ctx.strokeStyle = accent; ctx.lineWidth = Math.max(1, px(0.008)); ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(px(0.22), y); ctx.lineTo(g.W / 2 - w / 2 - px(0.07), y);
      ctx.moveTo(g.W / 2 + w / 2 + px(0.07), y); ctx.lineTo(g.W - px(0.22), y);
      ctx.stroke();
    }
    ctx.restore();
  }

  /** Bottom area: custom text (3-photo only), template tagline, date. Stacked and centered. */
  function drawFooter(ctx, g, v, dpi, ink, accent, areaTop, endY = g.H) {
    const S = CONFIG.strip, px = (n) => n * dpi, tpl = getTemplate(v.tpl), rows = [];
    const bigChin = v.layout.customText, small = !bigChin && !!v.layout.smallText, caption = (v.text || '').trim();
    const availH = endY - areaTop;                                      // small 4-photo space: text + date shrink to fit it
    ctx.textBaseline = 'middle';
    if ((bigChin || small) && caption) {
      let size = small ? Math.min(px(S.sizesIn.caption) * 0.6, availH * (v.showDate ? 0.46 : 0.72)) : px(S.sizesIn.caption);
      const f = () => `600 ${size}px ${S.fonts.caption}`;
      ctx.font = f();
      while (ctx.measureText(caption).width > g.pw && size > px(small ? 0.07 : 0.1)) { size -= px(0.01); ctx.font = f(); }
      const font = f(), sz = size;
      rows.push({ h: sz * 1.05, gap: 0, draw: (cy) => { ctx.font = font; ctx.fillStyle = ink; ctx.textAlign = 'center'; ctx.fillText(caption, g.W / 2, cy); } });
    }
    if (tpl.tagline) {
      if (bigChin && tpl.divider) {
        rows.push({ h: px(0.11), gap: rows.length ? px(0.05) : 0, draw: (cy) => {
          ctx.strokeStyle = accent; ctx.lineWidth = Math.max(1, px(0.008)); ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(px(0.3), cy); ctx.lineTo(g.W / 2 - px(0.14), cy);
          ctx.moveTo(g.W / 2 + px(0.14), cy); ctx.lineTo(g.W - px(0.3), cy);
          ctx.stroke();
          drawIcon(ctx, tpl.divider, g.W / 2, cy, px(0.045), accent);
        } });
      }
      const tFont = `${tpl.italic ? 'italic' : 'normal'} 500 ${px(S.sizesIn.tagline)}px ${S.fonts.brand}`;
      const tTr = px(tpl.italic ? 0.012 : S.taglineTracking);
      tpl.tagline.forEach((line, i) => {
        rows.push({ h: px(0.085), gap: i ? px(0.01) : (rows.length ? px(0.05) : 0), draw: (cy) => {
          ctx.font = tFont; ctx.fillStyle = ink; ctx.textBaseline = 'middle';
          const w = drawTracked(ctx, line, g.W / 2, cy, tTr);
          if (tpl.flank && i === 0) {
            ctx.strokeStyle = accent; ctx.lineWidth = Math.max(1, px(0.008)); ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(px(0.22), cy); ctx.lineTo(g.W / 2 - w / 2 - px(0.07), cy);
            ctx.moveTo(g.W / 2 + w / 2 + px(0.07), cy); ctx.lineTo(g.W - px(0.22), cy);
            ctx.stroke();
          }
        } });
      });
    }
    if (v.showDate) {
      const ds = small && caption ? Math.min(px(S.sizesIn.date), availH * 0.34) : px(S.sizesIn.date);
      rows.push({ h: ds * 1.05, gap: rows.length ? px(small ? 0.02 : 0.05) : 0, draw: (cy) => {
        ctx.font = `400 ${ds}px ${S.fonts.date}`; ctx.fillStyle = ink; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(formatDate(), g.W / 2, cy);
      } });
    }
    if (!rows.length) return;
    const total = rows.reduce((s, r) => s + r.h + r.gap, 0);
    let y = areaTop + (endY - areaTop - total) / 2;
    rows.forEach((r) => { y += r.gap; r.draw(y + r.h / 2); y += r.h; });
  }

  /* ---------- exclusive templates: each paints its own art. back = behind the photos, front = over them.
     c = { px, ink, frame, accent, pInk }  (pInk = readable text color on the frame color) ---------- */
  const rr = (ctx, x, y, w, h, r) => { ctx.moveTo(x + r, y); ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r); ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath(); };
  const txt = (ctx, s, x, y, font, color, align) => { ctx.font = font; ctx.fillStyle = color; ctx.textAlign = align || 'center'; ctx.textBaseline = 'middle'; ctx.fillText(s, x, y); };
  const fitFont = (ctx, s, size, make, maxW) => { let z = size; ctx.font = make(z); while (ctx.measureText(s).width > maxW && z > size * 0.4) { z *= 0.95; ctx.font = make(z); } return make(z); };
  const bars = (ctx, x, y, w, h, color) => {          // fixed-pattern barcode
    ctx.fillStyle = color; let i = 3, cx = x; const u = w / 130;
    while (cx < x + w - u) { i = (i * 37 + 11) % 7; const bw = (1 + i % 3) * u; ctx.fillRect(cx, y, Math.min(bw, x + w - cx), h); cx += bw + (1 + (i >> 1) % 2) * u; }
  };
  const dash = (ctx, x0, x1, y, color, u) => { ctx.save(); ctx.strokeStyle = color; ctx.lineWidth = Math.max(1, u * 0.35); ctx.setLineDash([u, u * 0.8]); ctx.beginPath(); ctx.moveTo(x0, y); ctx.lineTo(x1, y); ctx.stroke(); ctx.restore(); };
  const tag = (ctx, s, cx, cy, rot, size, font, bg, fg) => {   // small rotated label sticker
    ctx.save(); ctx.translate(cx, cy); ctx.rotate(rot); ctx.font = font;
    const w = ctx.measureText(s).width + size * 0.9, h = size * 1.5;
    ctx.beginPath(); rr(ctx, -w / 2, -h / 2, w, h, h * 0.3); ctx.fillStyle = bg; ctx.fill();
    ctx.strokeStyle = fg; ctx.lineWidth = Math.max(1, size * 0.08); ctx.stroke();
    ctx.fillStyle = fg; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(s, 0, size * 0.05); ctx.restore();
  };
  const gy = (g, i) => g.frames[i].y + g.frames[i].h + (g.frames[1] ? (g.frames[1].y - g.frames[0].y - g.frames[0].h) / 2 : 0);   // y between frame i and i+1
  const SK = '#3F4B5C';

  const PAINT = {
    ticket: {
      back(ctx, g, v, dpi, c) {
        const px = c.px;
        drawScallop(ctx, px(0.05), px(0.05), g.W - px(0.05), g.H - px(0.05), px(0.026), '#FBF7EE');
        ctx.strokeStyle = c.frame; ctx.lineWidth = Math.max(1, px(0.012));
        ctx.strokeRect(px(0.09), px(0.09), g.W - px(0.18), g.H - px(0.18));
        ctx.beginPath(); ctx.moveTo(px(0.09), px(0.44)); ctx.lineTo(g.W - px(0.09), px(0.44)); ctx.stroke();
      },
      front(ctx, g, v, dpi, c) {
        const px = c.px, F = CONFIG.strip.fonts, x0 = px(0.14), w = g.W - px(0.28);
        ctx.save(); ctx.fillStyle = c.frame; ctx.textBaseline = 'middle';
        ctx.font = `700 ${px(0.1)}px ${F.brand}`; drawTracked(ctx, CONFIG.strip.brandText, g.W / 2, px(0.25), px(0.012));
        const f = `400 ${px(0.052)}px ${F.date}`;
        if (v.showDate) txt(ctx, formatDate(), x0, px(0.375), f, c.frame, 'left');
        txt(ctx, 'ROW 01  SEAT 26', g.W - x0, px(0.375), f, c.frame, 'right');
        ctx.strokeStyle = c.frame; ctx.lineWidth = Math.max(1, px(0.012)); ctx.strokeRect(x0, g.H - px(0.31), w, px(0.195));
        const t = '★ ' + (v.tplText || '').trim().toUpperCase() + ' ★';
        txt(ctx, t, g.W / 2, g.H - px(0.2125), fitFont(ctx, t, px(0.11), (z) => `700 ${z}px ${F.brand}`, w - px(0.1)), c.frame);
        ctx.restore();
      },
    },
    receipt: {
      back(ctx, g, v, dpi, c) {
        const px = c.px, F = CONFIG.strip.fonts, T = getTemplate(v.tpl), x0 = px(0.14), x1 = g.W - px(0.14), col = withAlpha(c.ink, 0.5);
        txt(ctx, T.title, g.W / 2, px(0.125), fitFont(ctx, T.title, px(0.115), (z) => `400 ${z}px ${F.date}`, g.W - px(0.28)), c.ink);
        txt(ctx, T.sub, g.W / 2, px(0.235), fitFont(ctx, T.sub, px(0.058), (z) => `400 ${z}px ${F.date}`, g.W - px(0.28)), c.ink);
        dash(ctx, x0, x1, px(0.315), col, px(0.02)); dash(ctx, x0, x1, px(0.455), col, px(0.02));
        const f = `400 ${px(0.056)}px ${F.date}`;
        txt(ctx, v.showDate ? formatDate() : 'RECEIPT', x0, px(0.385), f, c.ink, 'left');
        txt(ctx, 'NO. 1112233', x1, px(0.385), f, c.ink, 'right');
        dash(ctx, x0, x1, g.bottomY + px(0.045), col, px(0.02));
      },
      front(ctx, g, v, dpi, c) {
        const px = c.px;
        txt(ctx, '* THANK YOU *', g.W / 2, g.H - px(0.215), `400 ${px(0.075)}px ${CONFIG.strip.fonts.date}`, c.ink);
        bars(ctx, px(0.14), g.H - px(0.165), g.W - px(0.28), px(0.1), c.ink);
      },
    },
    love: {
      back(ctx, g, v, dpi, c) {
        const px = c.px;
        ctx.fillStyle = c.frame; ctx.fillRect(px(0.07), px(0.07), g.W - px(0.14), g.H - px(0.14));
        ctx.beginPath(); rr(ctx, px(0.2), px(0.14), g.W - px(0.4), px(0.25), px(0.05)); ctx.fillStyle = c.frame; ctx.fill(); ctx.fillStyle = 'rgba(0,0,0,0.32)'; ctx.fill();
        ctx.strokeStyle = '#FBF7EE'; ctx.lineWidth = Math.max(1, px(0.01)); ctx.stroke();
        ctx.fillStyle = '#FBF7EE'; ctx.textBaseline = 'middle';
        ctx.font = `italic 500 ${px(0.085)}px ${CONFIG.strip.fonts.brand}`; drawTracked(ctx, CONFIG.strip.brandText, g.W / 2, px(0.27), px(0.012));
      },
      front(ctx, g, v, dpi, c) {
        const px = c.px, hand = (z) => `600 ${z}px ${CONFIG.strip.fonts.caption}`, m = g.frames.length - 2, cream = '#FBF7EE';
        tag(ctx, 'i love you', px(0.5), gy(g, 0), -0.12, px(0.1), hand(px(0.1)), cream, c.frame);
        tag(ctx, "it's me and you. always.", g.W - px(0.62), gy(g, 0) + px(0.01), 0.05, px(0.065), hand(px(0.065)), cream, c.frame);
        tag(ctx, 'favorite person', px(0.55), gy(g, m), 0.07, px(0.085), hand(px(0.085)), cream, c.frame);
        drawGlyph(ctx, 'heart', g.W - px(0.3), gy(g, m), px(0.13), { fill: c.frame, stroke: SK, lw: px(0.01) });
        ctx.save(); ctx.strokeStyle = SK; ctx.lineWidth = Math.max(1, px(0.012)); ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(g.W - px(0.5), gy(g, m) - px(0.05)); ctx.lineTo(g.W - px(0.12), gy(g, m) + px(0.01)); ctx.stroke(); ctx.restore();
      },
    },
    editorial: {
      back(ctx, g, v, dpi, c) {
        const px = c.px, F = CONFIG.strip.fonts;
        const tc = (inkFor(v.color) === CONFIG.strip.ink.light && inkFor(c.frame) === CONFIG.strip.ink.dark) ? v.color : c.pInk;
        ctx.fillStyle = c.frame; ctx.fillRect(0, 0, g.W, px(0.46)); ctx.fillRect(0, g.H - px(0.3), g.W, px(0.3));
        drawGlyph(ctx, 'sparkle', px(0.2), px(0.1), px(0.045), { fill: tc });
        ctx.strokeStyle = tc; ctx.lineWidth = Math.max(1, px(0.008)); ctx.beginPath(); ctx.moveTo(px(0.3), px(0.1)); ctx.lineTo(g.W - px(0.5), px(0.1)); ctx.stroke();
        txt(ctx, '1.0', g.W - px(0.2), px(0.1), `900 ${px(0.065)}px ${F.sans}`, tc, 'right');
        const t = CONFIG.strip.brandText;
