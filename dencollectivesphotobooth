  function stripFilename() {
    const d = new Date(), p = (n) => String(n).padStart(2, '0');
    const slug = CONFIG.brand.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    return `${slug}-${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}.png`;
  }

  async function enterResult() {
    if (state.rendering) return;
    state.rendering = true;
    $('printBtn').disabled = true;
    try {
      await ensureFonts();
      const c = document.createElement('canvas');
      renderStrip(c, CONFIG.strip.outputDpi);
      const blob = await new Promise((res) => c.toBlob(res, 'image/png'));
      if (!blob) throw new Error('toBlob failed');
      if (state.finalUrl) URL.revokeObjectURL(state.finalUrl);
      state.finalBlob = blob;                          // single strip: preview + print only
      state.sheetBlob = (await makeSheetBlob(c)) || blob;   // double-strip sheet: what Download / Share / Airdrop send
      state.finalUrl = URL.createObjectURL(blob);
      state.bundle = null; state.exportBase = stripFilename().replace(/\.png$/, '');
      state.livePromise = buildLiveStrip();          // hidden: never shown on this screen, only exported

      const img = $('stripImg');
      img.style.aspectRatio = `${CONFIG.strip.widthIn} / ${CONFIG.strip.heightIn}`;
      img.src = state.finalUrl;
      $('printImg').src = state.finalUrl;
      try { await img.decode(); } catch (e) { /* still fine to animate */ }
      $('toolbar').classList.remove('is-ready');
      show('result');
      startPrinting();
    } catch (err) {
      toast(CONFIG.messages.renderError);
    } finally {
      state.rendering = false;
      $('printBtn').disabled = false;
