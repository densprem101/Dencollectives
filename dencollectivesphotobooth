  function miniStrip(layout) {
    const g = geometry(layout, 20);                         // 40 x 120 units
    const frames = g.frames.map((f) => `<rect class="mini-fill" x="${f.x}" y="${f.y}" width="${f.w}" height="${f.h}"/><rect class="mini-line" style="stroke-width:1.6" x="${f.x}" y="${f.y}" width="${f.w}" height="${f.h}"/>`).join('');
    const cy = g.bottomY + (g.H - g.bottomY) / 2;
    const chin = layout.customText
      ? `<path class="mini-line" style="stroke-width:1.8" d="M9,${cy} q3,-5 6,0 t6,0 t6,0 t6,0"/>`
      : `<path class="mini-line" style="stroke-width:1.8" d="M14,${cy} h12"/>`;
    return `<svg class="mini" viewBox="-3 -3 46 126" aria-hidden="true"><rect class="mini-line" x="0" y="0" width="${g.W}" height="${g.H}"/>${frames}${chin}</svg>`;
  }

