  /** Pixel geometry of the strip at a given dpi. */
  function geometry(layout, dpi) {
    const S = CONFIG.strip;
    const px = (v) => Math.round(v * dpi);
    const W = px(S.widthIn), H = px(S.heightIn);
    const side = px(S.sideMarginIn), top = px(S.topMarginIn), gap = px(S.gapIn), bottom = px(layout.bottomIn);
    const pw = W - 2 * side;
    const ph = Math.floor((H - top - bottom - gap * (layout.count - 1)) / layout.count);
    const frames = Array.from({ length: layout.count }, (_, i) => ({ x: side, y: top + i * (ph + gap), w: pw, h: ph }));
    const bottomY = top + layout.count * ph + (layout.count - 1) * gap;
    return { W, H, pw, ph, frames, bottomY, aspect: pw / ph };
  }

  function hexToRgb(hex) {
    let h = String(hex).replace('#', '');
    if (h.length === 3) h = h.split('').map((c) => c + c).join('');
    const n = parseInt(h, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  const withAlpha = (hex, a) => { const [r, g, b] = hexToRgb(hex); return `rgba(${r},${g},${b},${a})`; };
  const inkFor = (hex) => { const [r, g, b] = hexToRgb(hex); return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.55 ? CONFIG.strip.ink.dark : CONFIG.strip.ink.light; };

  function formatDate() {
    const d = new Date().toLocaleDateString(CONFIG.strip.dateLocale, CONFIG.strip.dateFormat);
    return CONFIG.strip.dateUppercase ? d.toUpperCase() : d;
