  function buildStickerPalette() {
    const box = $('stickerPacks'), SK = CONFIG.stickers;
    SK.packs.forEach((p) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'stk pack'; b.dataset.pack = p.id;
