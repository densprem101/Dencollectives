<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Den collectives</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,400;1,500&family=Caveat:wght@500;600&family=Special+Elite&display=swap">
<style>
/* ==========================================================================
   DEN COLLECTIVES PHOTO BOOTH  -  styles
   Layout concept: one centered "stage" per screen on a cream canvas; every
   object is drawn like a pencil sketch (slate line, off-register pastel fill).
   All UI colors and fonts live in the tokens below. Edit them here.
   (Strip colors and all text labels live in CONFIG at the top of the script.)
   ========================================================================== */
:root {
  /* Palette: light blue + beige on an off-white cream canvas */
  --paper: #fbf7ee;        /* canvas / off-white cream */
  --paper-2: #f4ecdb;      /* soft beige wash */
  --beige: #e6d9be;        /* beige accent */
  --beige-deep: #cdbb96;   /* beige line / shadow */
  --blue: #a8c5e0;         /* light blue accent */
  --blue-soft: #d5e4f2;    /* pale blue wash */
  --blue-deep: #6f93b6;    /* focus + small marks */
  --ink: #3f4b5c;          /* slate "pencil" line */
  --ink-soft: #6c7889;     /* secondary text */

  /* Type roles */
  --font-display: "Cormorant Garamond", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
  --font-type: "Special Elite", "American Typewriter", "Courier New", ui-monospace, monospace;
  --font-hand: "Caveat", "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;

  /* Shape */
  --line: 2.5px;
  --r-sketch: 16px 5px 14px 6px / 6px 14px 5px 16px;
  --r-sketch-2: 6px 15px 6px 16px / 15px 6px 16px 5px;
  --gutter: 16px;

  color-scheme: light;
}

*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }

html, body { min-height: 100%; }

body {
  margin: 0;
  background-color: var(--paper);
  /* faint paper grain */
  background-image:
    radial-gradient(1200px 700px at 50% -10%, rgba(213, 228, 242, 0.55), transparent 70%),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' seed='4'/><feColorMatrix values='0 0 0 0 .55  0 0 0 0 .5  0 0 0 0 .4  0 0 0 .07 0'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  color: var(--ink);
  font-family: var(--font-type);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  overflow-x: hidden;
}

button, input { font: inherit; color: inherit; }
button { cursor: pointer; }
img, canvas, video, svg { max-width: 100%; }

:focus-visible {
  outline: 3px dashed var(--blue-deep);
  outline-offset: 3px;
}

.sr-only {
  position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

/* --------------------------------------------------------------------------
   Icons (sprite symbols are defined once in the HTML)
   -------------------------------------------------------------------------- */
.icon {
  width: 1.45em; height: 1.45em; flex: none;
  fill: none; stroke: currentColor; stroke-width: 1.7;
  stroke-linecap: round; stroke-linejoin: round;
}
.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

/* --------------------------------------------------------------------------
   Screens
   -------------------------------------------------------------------------- */
.app { min-height: 100dvh; }

.screen {
  min-height: 100dvh;
  display: flex; flex-direction: column; align-items: center;
  gap: clamp(14px, 2.4vw, 26px);
  padding-block: clamp(20px, 4vw, 44px);
  padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
  padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
  animation: screen-in 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}
@keyframes screen-in {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: none; }
}

.title {
  margin: 0; text-align: center; text-wrap: balance;
  font-family: var(--font-display); font-style: italic; font-weight: 500;
  font-size: clamp(2rem, 6.4vw, 3.4rem); line-height: 1.05; letter-spacing: 0.005em;
}
.lede {
  margin: 0; text-align: center; color: var(--ink-soft);
  font-size: 0.92rem; max-width: 34ch; text-wrap: balance;
}
.label {
  font-family: var(--font-type); font-size: 0.78rem; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--ink-soft);
}
.hand { font-family: var(--font-hand); font-weight: 600; color: var(--ink); }

/* --------------------------------------------------------------------------
   Buttons
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.6em;
  min-height: 48px; padding: 0.55em 1.4em;
  background: var(--paper); border: var(--line) solid var(--ink);
  border-radius: var(--r-sketch);
  font-family: var(--font-type); font-size: 1rem; letter-spacing: 0.02em;
  box-shadow: 3px 4px 0 var(--beige-deep);
  transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
}
.btn:hover:not(:disabled) { transform: translate(-1px, -1px); box-shadow: 4px 6px 0 var(--beige-deep); background: var(--paper-2); }
.btn:active:not(:disabled) { transform: translate(2px, 3px); box-shadow: 1px 1px 0 var(--beige-deep); }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn--primary { background: var(--blue-soft); box-shadow: 3px 4px 0 var(--blue); }
.btn--primary:hover:not(:disabled) { background: var(--blue); box-shadow: 4px 6px 0 var(--blue-deep); }
.btn--quiet {
  border-style: dashed; box-shadow: none; background: transparent; min-height: 42px;
  font-size: 0.9rem;
}
.btn--quiet:hover:not(:disabled) { box-shadow: none; background: var(--paper-2); }
.btn-row { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; align-items: center; }

/* --------------------------------------------------------------------------
   1. Landing: curtains + booth
   -------------------------------------------------------------------------- */
.screen--landing { justify-content: center; overflow: hidden; }

.booth {
  position: relative;
  width: min(100%, 520px, calc((100dvh - 140px) * 0.8));
  aspect-ratio: 640 / 800;
  container-type: inline-size;
}
.strip-photos svg { max-width: none; overflow: hidden; }
.strip-photos image { filter: grayscale(1) contrast(1.08); }
.booth-svg { display: block; width: 100%; height: 100%; max-width: none; overflow: visible; }

/* hand-colored fills sit slightly off the line, like a pencil + wash sketch */
.w-beige { fill: var(--beige); opacity: 0.55; }
.w-beige-deep { fill: var(--beige-deep); opacity: 0.5; }
.w-blue { fill: var(--blue); opacity: 0.8; }
.w-blue-deep { fill: var(--blue-deep); opacity: 0.45; }
.w-blue-soft { fill: var(--blue-soft); opacity: 0.95; }
.w-paper { fill: var(--paper); }
.ln { fill: none; stroke: var(--ink); stroke-width: var(--line); stroke-linecap: round; stroke-linejoin: round; }
.ln-thin { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linecap: round; opacity: 0.55; }
.t-sign { font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 35px; fill: var(--ink); }
.t-type { font-family: var(--font-type); font-size: 10px; fill: var(--ink); }

.enter-btn {
  position: absolute; left: 20%; top: 58.75%; width: 22.5%; height: 9.4%;
  display: flex; align-items: center; justify-content: center; gap: 4%;
  padding: 0; background: var(--paper); color: var(--ink);
  border: var(--line) solid var(--ink); border-radius: var(--r-sketch-2);
  box-shadow: 2px 3px 0 var(--blue);
  font-family: var(--font-hand); font-weight: 600;
  font-size: clamp(18px, 8vw, 34px);
  font-size: 7.4cqw;
  line-height: 1;
  transition: background-color 0.2s ease, transform 0.2s ease;
}
.enter-btn:hover { background: var(--blue-soft); transform: rotate(-1.5deg) scale(1.04); }
.enter-btn .icon { width: 0.8em; height: 0.8em; animation: nudge 1.6s ease-in-out infinite; }
@keyframes nudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(3px); } }

.hand-note { margin: 0; font-size: 1.5rem; text-align: center; color: var(--ink-soft); }

/* curtains */
.drape {
  position: fixed; top: 0; bottom: 0; width: 50.5%; z-index: 60; pointer-events: none;
  background-color: var(--blue);
  background-image:
    repeating-linear-gradient(90deg,
      rgba(255, 255, 255, 0.34) 0, rgba(255, 255, 255, 0.34) 3px,
      transparent 3px, transparent 34px,
      rgba(63, 75, 92, 0.1) 34px, rgba(63, 75, 92, 0.1) 37px,
      transparent 37px, transparent 60px);
  box-shadow: 0 0 0 var(--line) var(--ink) inset;
  will-change: transform;
}
.drape--left { left: 0; transform-origin: left center; border-right: var(--line) solid var(--ink); }
.drape--right { right: 0; transform-origin: right center; border-left: var(--line) solid var(--ink); }
.drape svg { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
.drape path { fill: none; stroke: var(--ink); stroke-width: 1.6px; opacity: 0.55; vector-effect: non-scaling-stroke; stroke-linecap: round; }
.rod {
  position: fixed; top: 0; left: 0; right: 0; height: 16px; z-index: 61; pointer-events: none;
  background: var(--beige); border-bottom: var(--line) solid var(--ink);
}

.screen--landing.is-opening .drape--left { animation: drape-left 2.8s cubic-bezier(0.6, 0, 0.2, 1) 0.7s forwards; }
.screen--landing.is-opening .drape--right { animation: drape-right 2.8s cubic-bezier(0.6, 0, 0.2, 1) 0.7s forwards; }
.screen--landing.is-opening .rod { animation: fade-out 0.6s ease 3.1s forwards; }
@keyframes drape-left {
  0% { transform: translateX(0) scaleX(1); }
  60% { transform: translateX(-34%) scaleX(0.6); }
  100% { transform: translateX(-47%) scaleX(0.12); }
}
@keyframes drape-right {
  0% { transform: translateX(0) scaleX(1); }
  60% { transform: translateX(34%) scaleX(0.6); }
  100% { transform: translateX(47%) scaleX(0.12); }
}
@keyframes fade-out { to { opacity: 0; } }
.screen--landing.is-open .drape, .screen--landing.is-open .rod { display: none; }

/* --------------------------------------------------------------------------
   2. Setup
   -------------------------------------------------------------------------- */
.panel {
  width: min(100%, 720px);
  background: var(--paper); border: var(--line) solid var(--ink);
  border-radius: var(--r-sketch); box-shadow: 5px 6px 0 var(--beige);
  padding: clamp(18px, 4vw, 34px);
  display: flex; flex-direction: column; gap: clamp(18px, 3vw, 28px);
}
fieldset { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
legend { padding: 0; margin-bottom: 4px; }

.choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.choice { position: relative; display: block; min-width: 0; }
.choice input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.choice-card {
  height: 100%; display: flex; align-items: center; gap: 16px;
  padding: 14px 16px; background: var(--paper);
  border: var(--line) solid var(--ink); border-radius: var(--r-sketch-2);
  transition: background-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}
.choice-card svg.mini { width: 40px; height: auto; flex: none; }
.choice-name { display: block; font-size: 1.02rem; line-height: 1.2; }
.choice-hint { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--ink-soft); line-height: 1.3; }
.choice input:hover + .choice-card { background: var(--paper-2); }
.choice input:checked + .choice-card { background: var(--blue-soft); box-shadow: 4px 5px 0 var(--blue); transform: translate(-1px, -1px); }
.choice input:focus-visible + .choice-card { outline: 3px dashed var(--blue-deep); outline-offset: 3px; }
.choice .tick {
  position: absolute; top: -9px; right: -7px; width: 28px; height: 28px; padding: 3px;
  background: var(--paper); border: var(--line) solid var(--ink); border-radius: 50%;
  opacity: 0; transform: scale(0.6) rotate(-12deg); transition: opacity 0.18s, transform 0.18s;
}
.choice input:checked ~ .tick { opacity: 1; transform: none; }
.mini-line { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
.mini-fill { fill: var(--blue); opacity: 0.7; }

.chips { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
.chip { position: relative; display: block; }
.chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.chip span {
  display: flex; align-items: center; justify-content: center; min-height: 52px;
  background: var(--paper); border: var(--line) solid var(--ink); border-radius: var(--r-sketch);
  font-family: var(--font-hand); font-weight: 600; font-size: 1.9rem; line-height: 1;
  transition: background-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}
.chip input:hover + span { background: var(--paper-2); }
.chip input:checked + span { background: var(--blue-soft); box-shadow: 3px 4px 0 var(--blue); transform: translate(-1px, -1px); }
.chip input:focus-visible + span { outline: 3px dashed var(--blue-deep); outline-offset: 3px; }
.help { margin: 0; font-size: 0.82rem; color: var(--ink-soft); }
.setup-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: space-between; align-items: center; }

/* --------------------------------------------------------------------------
   3. Capture
   -------------------------------------------------------------------------- */
.capture-grid {
  width: min(100%, 940px);
  display: grid; grid-template-columns: minmax(0, 1fr) 176px; gap: clamp(16px, 3vw, 30px);
  align-items: start;
}
.stage { display: flex; flex-direction: column; align-items: center; gap: 16px; min-width: 0; }

.frame {
  position: relative; padding: 12px;
  width: min(100%, calc((100dvh - 330px) * var(--ar, 1.37)));
  min-width: min(100%, 260px);
  background: var(--paper); border: var(--line) solid var(--ink); border-radius: var(--r-sketch-2);
  box-shadow: 5px 6px 0 var(--beige);
}
.frame::before {
  content: ""; position: absolute; inset: 4px; pointer-events: none;
  border: 1.5px solid var(--ink); border-radius: var(--r-sketch); opacity: 0.55;
}
.viewfinder {
  position: relative; width: 100%; aspect-ratio: var(--ar, 1.37); overflow: hidden;
  background: var(--blue-soft); border: var(--line) solid var(--ink); border-radius: 4px;
}
.viewfinder video {
  position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover;
  transform: scaleX(-1) scale(var(--camz, 1)); background: var(--blue-soft);
}
.viewfinder.no-mirror video { transform: scale(var(--camz, 1)); }
.viewfinder.is-idle video { visibility: hidden; }

.cam-msg {
  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 12px; padding: 16px; text-align: center; background: var(--blue-soft);
}
.cam-msg p { margin: 0; font-size: 0.88rem; max-width: 34ch; text-wrap: balance; }
.cam-msg .btn { min-height: 42px; font-size: 0.9rem; }

.count {
  position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none;
}
.count-num {
  font-family: var(--font-hand); font-weight: 600; color: #fff;
  font-size: clamp(5rem, 22vw, 10rem); line-height: 1;
  text-shadow: 0 2px 0 var(--ink), 0 0 18px rgba(63, 75, 92, 0.55), 2px 3px 0 var(--ink), -2px 2px 0 var(--ink);
  animation: tick 1s ease-out both;
}
@keyframes tick { from { transform: scale(1.5); opacity: 0.2; } 25% { opacity: 1; } to { transform: scale(0.9); opacity: 0.95; } }
.flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
.flash.go { animation: flash 0.28s ease-out; }
@keyframes flash { from { opacity: 0.95; } to { opacity: 0; } }

.pose-label { margin: 0; min-height: 1.5em; text-align: center; }
.note-eye {
  position: absolute; left: -8px; top: 34%; transform: translateX(-100%);
  display: none; align-items: center; gap: 4px; font-size: 1.5rem; line-height: 0.95; text-align: right;
  color: var(--ink);
}
@media (min-width: 1040px) { .note-eye { display: flex; } }
.note-eye svg { width: 48px; height: 26px; flex: none; }

.slots { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
.slot { position: relative; min-width: 0; }
.slot-frame {
  position: relative; aspect-ratio: var(--ar, 1.37); overflow: hidden;
  background: var(--paper); border: var(--line) dashed var(--beige-deep); border-radius: 5px;
  display: grid; place-items: center;
  font-family: var(--font-hand); font-weight: 600; font-size: 2rem; color: var(--beige-deep);
}
.slot.is-filled .slot-frame { border: var(--line) solid var(--ink); }
.slot.is-active .slot-frame { border-color: var(--blue-deep); background: var(--blue-soft); color: var(--blue-deep); }
.slot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.redo {
  position: absolute; right: 6px; bottom: 6px; z-index: 1;
  display: inline-flex; align-items: center; gap: 5px; min-height: 34px; padding: 3px 10px;
  background: var(--paper); border: 2px solid var(--ink); border-radius: var(--r-sketch);
  font-family: var(--font-type); font-size: 0.82rem; box-shadow: 2px 2px 0 var(--beige-deep);
}
.redo .icon { width: 1.1em; height: 1.1em; }
.redo:hover:not(:disabled) { background: var(--blue-soft); }
.redo:disabled { opacity: 0.45; cursor: not-allowed; }

/* --------------------------------------------------------------------------
   4. Edit
   -------------------------------------------------------------------------- */
.edit-grid {
  width: min(100%, 880px);
  display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(20px, 4vw, 44px);
  align-items: start;
}
.preview-wrap {
  position: sticky; top: 20px; justify-self: center; width: 100%;
  display: flex; justify-content: center;
}
.preview-card {
  padding: 12px; background: var(--paper); border: var(--line) solid var(--ink);
  border-radius: var(--r-sketch-2); box-shadow: 5px 6px 0 var(--beige);
  width: min(100%, calc((100dvh - 150px) / 3 + 28px));
}
.preview-card canvas { display: block; width: 100%; height: auto; }

.controls { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
.swatches { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.swatch { position: relative; width: 44px; height: 44px; }
.swatch input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.swatch span {
  display: block; width: 100%; height: 100%; border: var(--line) solid var(--ink); border-radius: 50%;
  background: var(--sw); transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.swatch input:hover + span { transform: scale(1.06); }
.swatch input:checked + span { box-shadow: 0 0 0 3px var(--paper), 0 0 0 5.5px var(--ink); }
.swatch input:focus-visible + span { outline: 3px dashed var(--blue-deep); outline-offset: 6px; }
.swatch--custom span { background: conic-gradient(var(--blue), var(--beige), var(--blue-soft), var(--paper-2), var(--blue)); }
.swatch--custom input[type="color"] { opacity: 0; }
.swatch--custom.is-active span { box-shadow: 0 0 0 3px var(--paper), 0 0 0 5.5px var(--ink); }

.filter-chips {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 8px;
  max-height: 232px; overflow-y: auto; overscroll-behavior: contain; padding: 4px 6px 8px 2px;
  -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--ink-soft) transparent;
}
.filter-chips .chip span {
  flex-direction: column; gap: 3px; padding: 7px 8px; min-height: 52px; text-align: center;
  font-family: var(--font-type); line-height: 1.1;
}
.filter-chips .f-name { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; }
.filter-chips .f-desc { font-size: 0.62rem; font-weight: 400; color: var(--ink-soft); line-height: 1.15; }
@media (max-width: 560px) {
  .filter-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); max-height: 216px; }
  .filter-chips .chip span { font-size: inherit; min-height: 48px; }
}

.toggle { display: flex; align-items: center; gap: 14px; cursor: pointer; min-height: 44px; }
.toggle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.toggle .track {
  position: relative; flex: none; width: 54px; height: 30px;
  background: var(--paper); border: var(--line) solid var(--ink); border-radius: 30px;
  transition: background-color 0.18s ease;
}
.toggle .track::after {
  content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px;
  background: var(--ink); border-radius: 50%; transition: transform 0.18s ease, background-color 0.18s ease;
}
.toggle input:checked + .track { background: var(--blue); }
.toggle input:checked + .track::after { transform: translateX(24px); }
.toggle input:focus-visible + .track { outline: 3px dashed var(--blue-deep); outline-offset: 3px; }
.toggle .t-text { font-size: 0.95rem; line-height: 1.25; }

.text-field { display: flex; flex-direction: column; gap: 8px; }
.text-field input {
  min-height: 50px; padding: 8px 14px; background: var(--paper);
  border: var(--line) solid var(--ink); border-radius: var(--r-sketch);
  font-family: var(--font-hand); font-weight: 600; font-size: 1.5rem; width: 100%;
}
.text-field input::placeholder { color: var(--beige-deep); }
.text-field input:focus-visible { outline: 3px dashed var(--blue-deep); outline-offset: 3px; }

/* --------------------------------------------------------------------------
   5. Result: dispenser, strip, toolbar, tip box
   -------------------------------------------------------------------------- */
.result-stage {
  width: min(100%, 860px);
