  function startPrinting() {
    const d = $('dispenser');
    d.classList.remove('printing', 'printed');
    void d.offsetWidth;
    const ms = reducedMotion() ? 10 : CONFIG.dispenser.printMs;
    d.style.setProperty('--print-ms', ms + 'ms');
    d.classList.add('printing');
    setTimeout(() => {
      d.classList.remove('printing'); d.classList.add('printed');
      Promise.race([state.livePromise || 0, sleep(20000)]).then(() => $('toolbar').classList.add('is-ready'));   // share needs the files ready
    }, ms + 150);
  }

  /* ---------- Live Photo export: exactly two assets, the static double-strip sheet and the live double-strip video, always travel together ---------- */
  const crcTable = (() => { const t = []; for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();
  const crc32 = (u8) => { let c = -1; for (let i = 0; i < u8.length; i++) c = crcTable[(c ^ u8[i]) & 255] ^ (c >>> 8); return (c ^ -1) >>> 0; };

  /** Minimal ZIP writer (stored, no compression) so one file opens on iOS, Android, Windows, macOS and ChromeOS. */
  async function makeZip(files) {
    const enc = new TextEncoder(), parts = [], central = [], d = new Date();
    const time = (d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1);
    const date = ((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate();
    let offset = 0;
    for (const f of files) {
      const data = new Uint8Array(await f.blob.arrayBuffer()), name = enc.encode(f.name), crc = crc32(data);
      const lh = new DataView(new ArrayBuffer(30));
      lh.setUint32(0, 0x04034b50, true); lh.setUint16(4, 20, true); lh.setUint16(6, 0x0800, true);
      lh.setUint16(10, time, true); lh.setUint16(12, date, true); lh.setUint32(14, crc, true);
      lh.setUint32(18, data.length, true); lh.setUint32(22, data.length, true); lh.setUint16(26, name.length, true);
      parts.push(lh.buffer, name, data);
      const ch = new DataView(new ArrayBuffer(46));
      ch.setUint32(0, 0x02014b50, true); ch.setUint16(4, 20, true); ch.setUint16(6, 20, true); ch.setUint16(8, 0x0800, true);
      ch.setUint16(12, time, true); ch.setUint16(14, date, true); ch.setUint32(16, crc, true);
      ch.setUint32(20, data.length, true); ch.setUint32(24, data.length, true); ch.setUint16(28, name.length, true); ch.setUint32(42, offset, true);
      central.push(ch.buffer, name);
      offset += 30 + name.length + data.length;
    }
    const end = new DataView(new ArrayBuffer(22));
    end.setUint32(0, 0x06054b50, true); end.setUint16(8, files.length, true); end.setUint16(10, files.length, true);
    end.setUint32(12, central.reduce((s, p) => s + p.byteLength, 0), true); end.setUint32(16, offset, true);
    return new Blob([...parts, ...central, end.buffer], { type: 'application/zip' });
  }

  const sheetImage = () => state.sheetBlob || state.finalBlob;
  const liveFiles = () => (state.liveBlob ? [{ name: `${state.exportBase}-live.${state.liveExt}`, blob: state.liveBlob }] : []);

  async function bundleBlob() {
    if (!state.bundle) state.bundle = await makeZip([{ name: `${state.exportBase}.png`, blob: sheetImage() }, ...liveFiles()]);
    return state.bundle;
  }

  /** Save through the host's download capability when present, else a normal download link. */
  async function saveBlob(blob, name) {
    try {
      const claude = window.claude;
      const dl = claude && claude.use ? await claude.use('downloads') : null;
      if (dl) { await dl.save({ filename: name, data: blob }); return; }
    } catch (e) {
      if (e && e.code === 'declined') return;
    }
    const url = URL.createObjectURL(blob), a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 60000);
    toast(CONFIG.messages.downloadStarted);
  }

  /** Download: one ZIP holding the static double-strip sheet + the live double-strip video (a plain PNG sheet only when no live version exists, e.g. uploaded photos). */
  async function saveStrip() {
    if (!state.finalBlob) return;
    if (liveFiles().length) await saveBlob(await bundleBlob(), `${state.exportBase}.zip`);
    else await saveBlob(sheetImage(), `${state.exportBase}.png`);
  }

  /** Native share sheet (AirDrop, Nearby Share, Messages, Windows share...): static sheet + live sheet together, else the ZIP. Returns true when handled. */
  async function nativeShare(title) {
    const png = new File([sheetImage()], `${state.exportBase}.png`, { type: 'image/png' });
    const clips = liveFiles().map((f) => new File([f.blob], f.name, { type: f.blob.type }));
    const sets = [[png, ...clips]];
    if (clips.length) sets.push([new File([await bundleBlob()], `${state.exportBase}.zip`, { type: 'application/zip' })]);
    for (const files of sets) {
      try {
        if (navigator.canShare && navigator.canShare({ files })) { await navigator.share({ files, title }); return true; }
      } catch (e) {
        if (e && e.name === 'AbortError') return true;
      }
    }
    return false;
  }

  async function shareStrip() {
    if (!state.finalBlob) return;
    if (await nativeShare(CONFIG.brand.name)) return;
    await saveStrip();
    toast(CONFIG.messages.shareFallback);
  }

  /** AirDrop: the browser can't call it directly, so open the native share sheet where AirDrop is listed. */
  async function airdropStrip() {
    if (!state.finalBlob) return;
    if (await nativeShare(CONFIG.brand.name)) return;
    await saveStrip();
    toast(CONFIG.messages.airdropFallback);
  }

  function printStrip() {
    try { window.print(); } catch (e) { /* handled by the hint below */ }
    toast(CONFIG.messages.printHint, 5200);
  }

  function resetAll() {
    stopCamera();
    if (state.finalUrl) URL.revokeObjectURL(state.finalUrl);
    state.finalUrl = null; state.finalBlob = null; state.sheetBlob = null; state.bundle = null;
    state.liveBlob = null; state.liveExt = ''; state.livePromise = null; state.liveToken++;
    state.layoutId = CONFIG.defaults.layout; state.delay = CONFIG.defaults.delay;
    state.hQuotes = null; state.photos = []; state.photoSeq = 0; state.activeSlot = -1; state.running = false;
    state.filterId = CONFIG.defaults.filter; state.stripColor = (CONFIG.templates.find((t) => t.id === CONFIG.defaults.template) || {}).bg || CONFIG.strip.defaultColor;
    state.showDate = CONFIG.defaults.showDate; state.customText = '';
    state.templateId = CONFIG.defaults.template; state.frameColor = (CONFIG.templates.find((t) => t.id === CONFIG.defaults.template) || {}).frame || null; state.tplText = (CONFIG.templates.find((t) => t.id === CONFIG.defaults.template) || {}).text || 'DEN SNAPBOX'; state.bgCanvas = null; state.bgName = '';
    state.stickers = []; state.stickerPack = null;
    state.uploadMode = false; state.camStatus = 'idle';
    filterCache.clear();
    $('stripImg').removeAttribute('src');
    syncSetupForm();
  }

  function restart() {
    resetAll();
    show('landing');
    playCurtains();
  }

  /* ======================================================================
     10. TIP MODAL
     ====================================================================== */
  let tipOpener = null;
  function openTip() {
    tipOpener = document.activeElement;
    $('tipModal').hidden = false;
    $('tipClose').focus();
  }
  function closeTip() {
    $('tipModal').hidden = true;
    if (tipOpener && tipOpener.focus) tipOpener.focus();
  }


  /* ======================================================================
     10b. FOLLOW LINK + FEEDBACK BUBBLE
     ====================================================================== */
  function setChat(open) {
    $('chatPanel').hidden = !open;
    $('chatBtn').setAttribute('aria-expanded', String(open));
    if (open) $('fbMessage').focus({ preventScroll: true });
  }

  async function onFeedbackSubmit(e) {
    e.preventDefault();
    const F = CONFIG.feedback, M = CONFIG.messages, status = $('chatStatus'), btn = $('fbSend');
    const name = $('fbName').value.trim(), contact = $('fbContact').value.trim(), message = $('fbMessage').value.trim();
    if (!message) { status.textContent = M.fbEmpty; $('fbMessage').focus(); return; }
    btn.disabled = true;
    if (F.endpoint) {
      status.textContent = M.fbSending;
      try {
        const fd = new FormData();
        if (F.accessKey) fd.append('access_key', F.accessKey);
        fd.append('subject', F.subject);
        fd.append('name', name || 'Anonymous');
        if (contact) fd.append('email', contact);
        fd.append('message', message);
        const res = await fetch(F.endpoint, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        let ok = res.ok;
        try { const j = await res.json(); if (j && j.success === false) ok = false; } catch (err) { /* not JSON */ }
        if (!ok) throw new Error('rejected');
        status.textContent = M.fbSent;
        $('chatForm').reset();
      } catch (err) {
        status.textContent = fmt(M.fbError, { email: F.toEmail });
      } finally { btn.disabled = false; }
      return;
    }
    // No endpoint configured: hand the message to the visitor's email app.
    const body = `${message}\n\n${name ? '- ' + name : ''}${contact ? ' (' + contact + ')' : ''}`.trim();
    const a = document.createElement('a');
    a.href = `mailto:${F.toEmail}?subject=${encodeURIComponent(F.subject)}&body=${encodeURIComponent(body)}`;
    document.body.appendChild(a); a.click(); a.remove();
    status.textContent = fmt(M.fbMailto, { email: F.toEmail });
    btn.disabled = false;
  }

  function initExtras() {
    document.querySelectorAll('.creator-link').forEach((a) => { a.href = CONFIG.social.url; });
    $('chatBtn').addEventListener('click', () => setChat($('chatPanel').hidden));
    $('chatClose').addEventListener('click', () => { setChat(false); $('chatBtn').focus(); });
    $('chatForm').addEventListener('submit', onFeedbackSubmit);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('chatPanel').hidden && $('tipModal').hidden) { setChat(false); $('chatBtn').focus(); }
    });
  }

  /* ======================================================================
     11. BOOT
     ====================================================================== */
  function init() {
    applyText();
    document.body.dataset.screen = 'landing';
    initExtras();
    buildSetup();
    buildEditControls();
    syncSetupForm();
    $('customText').maxLength = CONFIG.strip.customTextMaxLength;
    if (CONFIG.tip.qrSrc) $('tipQr').src = CONFIG.tip.qrSrc;

    $('enterBtn').addEventListener('click', () => { show('setup'); const c = document.querySelector('input[name="layout"]:checked'); if (c) c.focus({ preventScroll: true }); });
    $('setupBack').addEventListener('click', () => { show('landing'); });
    $('setupForm').addEventListener('submit', onSetupSubmit);

    $('captureBtn').addEventListener('click', onCapture);
    $('cancelBtn').addEventListener('click', () => { state.cancel = true; });
    $('captureBack').addEventListener('click', () => { stopCamera(); show('setup'); });
    $('toEditBtn').addEventListener('click', enterEdit);
    $('fileInput').addEventListener('change', onFilesChosen);
    $('camRetry').addEventListener('click', () => { state.uploadMode = false; startCamera(); });
    $('camUpload').addEventListener('click', () => {
      if (!state.uploadMode) { state.uploadMode = true; stopCamera(); refreshCamMsg(); updateCaptureUI(); }
      else pickFiles(defaultTargets(), true);
    });

    $('editBack').addEventListener('click', () => { enterCapture(); });
    $('printBtn').addEventListener('click', enterResult);

    $('actDownload').addEventListener('click', saveStrip);
    $('actShare').addEventListener('click', shareStrip);
    const appleShare = typeof navigator.share === 'function' && (/iPhone|iPad|iPod|Macintosh/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1));
    $('actAirdrop').hidden = !appleShare;                                   // Apple devices only
    $('toolbar').style.setProperty('--tools', appleShare ? 5 : 4);
    $('actAirdrop').addEventListener('click', airdropStrip);
    $('camZoom').addEventListener('click', toggleCamWide);
    $('actPrint').addEventListener('click', printStrip);
    $('actRestart').addEventListener('click', restart);

    $('tipBtn').addEventListener('click', openTip);
    $('tipClose').addEventListener('click', closeTip);
    $('tipModal').addEventListener('click', (e) => { if (e.target === $('tipModal')) closeTip(); });
    document.addEventListener('keydown', (e) => {
      if ($('tipModal').hidden) return;
      if (e.key === 'Escape') closeTip();
      if (e.key === 'Tab') { e.preventDefault(); $('tipClose').focus(); }   // single focusable control
    });

    window.addEventListener('pagehide', stopCamera);
    ensureFonts().then(() => { if (state.screen === 'edit') { renderTemplateMinis(); schedulePreview(); } });
    playCurtains();
  }

  init();
})();

</script>

</body></html>
