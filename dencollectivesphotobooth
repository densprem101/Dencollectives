  async function startCamera() {
    stopCamera();
    setCamStatus('loading');
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) { setCamStatus('unavailable'); return; }
    try {
      const stream = await navigator.mediaDevices.getUserMedia(CONFIG.camera.constraints);
      if (state.screen !== 'capture') { stream.getTracks().forEach((t) => t.stop()); return; }
      state.stream = stream;
      const v = video();
      v.muted = true; v.setAttribute('playsinline', ''); v.srcObject = stream;
      await Promise.race([
        new Promise((res) => { if (v.readyState >= 2) res(); else v.addEventListener('loadeddata', res, { once: true }); }),
        sleep(8000),
      ]);
      try { await v.play(); } catch (e) { /* autoplay can be refused; the stream still renders once visible */ }
      setCamStatus(v.videoWidth ? 'ready' : 'unavailable');
      if (state.camStatus === 'ready') setupCamZoom();
    } catch (err) {
      setCamStatus(err && (err.name === 'NotAllowedError' || err.name === 'SecurityError') ? 'denied' : 'unavailable');
    }
  }

  function stopCamera() {
    if (state.stream) { state.stream.getTracks().forEach((t) => t.stop()); state.stream = null; }
    const v = video();
    if (v) v.srcObject = null;
    if (state.camStatus === 'ready' || state.camStatus === 'loading') state.camStatus = 'idle';
    camZ(1);
  }

  /* ---------- front camera wide / normal toggle ----------
     Shown only where a wide front camera is likely: a track that reports a zoom-out range, or an iPhone / iPad.
     Real zoom-out is used when the browser exposes it; otherwise 'normal' is a light center crop and 'wide' the full frame. */
  const camWide = { on: false, zoom: null };
  const NORMAL_CROP = 1.18;
  const isAppleTouch = () => /iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  function camZ(z) { state.camZoom = z; const vf = $('viewfinder'); if (vf) vf.style.setProperty('--camz', z); }
  function syncCamZoomUI() {
    const b = $('camZoom'), T = CONFIG.text;
    b.classList.toggle('is-wide', camWide.on); b.setAttribute('aria-pressed', String(camWide.on));
    b.setAttribute('aria-label', camWide.on ? T.camToNormal : T.camToWide);
    b.querySelector('use').setAttribute('href', camWide.on ? '#i-cam-in' : '#i-cam-out');   // arrows apart = normal, arrows together = wide
  }
  function setupCamZoom() {
    const track = state.stream && state.stream.getVideoTracks()[0];
    let caps = {}; try { caps = (track && track.getCapabilities && track.getCapabilities()) || {}; } catch (e) { /* ignore */ }
    camWide.on = false; camWide.zoom = null; camZ(1);
    let ok = false;
    if (caps.zoom && caps.zoom.min < 1) { camWide.zoom = caps.zoom; ok = true; }
    else if (isAppleTouch()) { ok = true; camZ(NORMAL_CROP); }
    $('camZoom').hidden = !ok; syncCamZoomUI();
  }
  async function toggleCamWide() {
    camWide.on = !camWide.on;
    if (camWide.zoom) {
      const track = state.stream && state.stream.getVideoTracks()[0];
      try { await track.applyConstraints({ advanced: [{ zoom: camWide.on ? camWide.zoom.min : 1 }] }); } catch (e) { camWide.on = !camWide.on; }
    } else camZ(camWide.on ? 1 : NORMAL_CROP);
    syncCamZoomUI();
  }


  /** Draw src into the box (dx,dy,dw,dh), center-cropped like object-fit: cover. */
  function drawCover(ctx, src, sw, sh, dx, dy, dw, dh, mirror, zoom = 1) {
    const sr = sw / sh, dr = dw / dh;
    let cx, cy, cw, ch;
    if (sr > dr) { ch = sh; cw = sh * dr; cx = (sw - cw) / 2; cy = 0; }
    else { cw = sw; ch = sw / dr; cx = 0; cy = (sh - ch) / 2; }
    if (zoom > 1) { cx += cw * (1 - 1 / zoom) / 2; cy += ch * (1 - 1 / zoom) / 2; cw /= zoom; ch /= zoom; }   // digital crop
    ctx.save();
    if (mirror) { ctx.translate(dx + dw, dy); ctx.scale(-1, 1); ctx.drawImage(src, cx, cy, cw, ch, 0, 0, dw, dh); }
    else ctx.drawImage(src, cx, cy, cw, ch, dx, dy, dw, dh);
    ctx.restore();
  }

  function setPhoto(idx, canvas) {
    const tw = CONFIG.thumb.width;
    const t = document.createElement('canvas');
    t.width = tw; t.height = Math.round(tw * canvas.height / canvas.width);
    t.getContext('2d').drawImage(canvas, 0, 0, t.width, t.height);
    state.photos[idx] = { id: ++state.photoSeq, canvas, thumb: t.toDataURL('image/jpeg', 0.82) };
    renderSlots();
    updateCaptureUI();
  }

  /* ======================================================================
     LIVE PHOTO (always on). While a shot is taken we only buffer small frames (last countdown second plus a
     moment after the shutter, cropped and mirrored like the photo). Nothing is exported per shot: when the
     strip is finished, buildLiveStrip() plays all shots together inside the real strip and records ONE video.
     MP4 where the browser can record it (Safari, newer Chrome/Android), WebM elsewhere.
     ====================================================================== */
  const LIVE_TYPES = ['video/mp4;codecs=avc1.42E01E', 'video/mp4', 'video/webm;codecs=vp9', 'video/webm;codecs=vp8', 'video/webm'];
  const liveType = () => (window.MediaRecorder && HTMLCanvasElement.prototype.captureStream
    ? LIVE_TYPES.find((t) => { try { return MediaRecorder.isTypeSupported(t); } catch (e) { return false; } }) : null);

  function startLive() {
    const v = video();
    if (!v || !v.videoWidth || !liveType()) return null;       // no recorder on this browser: skip buffering
    const g = geometry(currentLayout(), CONFIG.strip.outputDpi), L = CONFIG.live;
    const w = L.frameWidth, h = Math.round(w * g.ph / g.pw), frames = [];
    const grab = () => {
      const c = document.createElement('canvas'); c.width = w; c.height = h;
      drawCover(c.getContext('2d'), v, v.videoWidth, v.videoHeight, 0, 0, w, h, CONFIG.camera.mirrorOutput, state.camZoom || 1);
      frames.push(c);
    };
    grab();
    const timer = setInterval(grab, 1000 / L.fps);
    $('viewfinder').classList.add('is-rec');
    return { stop() { clearInterval(timer); $('viewfinder').classList.remove('is-rec'); return frames; } };
  }

  /** Classic photo-booth sheet: the same finished strip twice, side by side (export only, static and live). */
  function drawSheet(ctx, strip, sw, sh, gap) {
    const S = CONFIG.sheet;
    ctx.fillStyle = S.bg; ctx.fillRect(0, 0, 2 * sw + gap, sh);
    ctx.drawImage(strip, 0, 0, sw, sh);
    ctx.drawImage(strip, sw + gap, 0, sw, sh);
    if (S.cutLine && !gap) {                                    // dashed cut guide between the two strips
      ctx.save();
      ctx.globalAlpha = 0.35; ctx.strokeStyle = CONFIG.strip.ink.dark; ctx.lineWidth = Math.max(1, sw / 400);
      ctx.setLineDash([sw / 36, sw / 54]);
      ctx.beginPath(); ctx.moveTo(sw, 0); ctx.lineTo(sw, sh); ctx.stroke();
      ctx.restore();
    }
  }

  async function makeSheetBlob(strip) {
    const gap = Math.round(CONFIG.sheet.gapIn * CONFIG.strip.outputDpi), s = document.createElement('canvas');
    s.width = 2 * strip.width + gap; s.height = strip.height;
    drawSheet(s.getContext('2d'), strip, strip.width, strip.height, gap);
    return new Promise((res) => s.toBlob(res, 'image/png'));
  }

  /** The Live Photo sheet: ONE video of two identical moving strips, same template / filter / stickers / text as the static sheet. */
  async function buildLiveStrip() {
    const token = ++state.liveToken, L = CONFIG.live, type = liveType();
    state.liveBlob = null; state.liveExt = ''; state.bundle = null;
    if (!type || !state.photos.some((p) => p && p.frames && p.frames.length > 1)) return;   // e.g. uploaded photos: static only
    const out = document.createElement('canvas');
    try {
      await ensureFonts();
      const g = geometry(currentLayout(), L.dpi), W = Math.round(g.W / 2) * 2, H = Math.round(g.H / 2) * 2;
      const steps = Math.max(...state.photos.map((p) => (p && p.frames ? p.frames.length : 1)));
      const work = document.createElement('canvas'), seq = [];
      for (let k = 0; k < steps; k++) {                         // pre-render every step so recording is perfectly paced
        const photos = state.photos.map((p, i) => p && (p.frames
          ? { id: `live${i}-${k}`, canvas: p.frames[Math.min(k, p.frames.length - 1)] } : { id: p.id, canvas: p.canvas }));
        renderStrip(work, L.dpi, { photos });
        const f = document.createElement('canvas'); f.width = W; f.height = H;
        f.getContext('2d').drawImage(work, 0, 0, W, H);
        seq.push(f);
        await sleep(0);
        if (token !== state.liveToken) return;
      }
      const gap = 2 * Math.round(CONFIG.sheet.gapIn * L.dpi / 2);
      out.width = 2 * W + gap; out.height = H;
      out.style.cssText = 'position:fixed;left:-9999px;top:0;width:1px;height:1px;opacity:0;pointer-events:none';
      document.body.appendChild(out);
      const octx = out.getContext('2d');
      drawSheet(octx, seq[0], W, H, gap);
      const rec = new MediaRecorder(out.captureStream(L.fps), { mimeType: type, videoBitsPerSecond: L.bitrate });
      const chunks = [];
      rec.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
      const stopped = new Promise((res) => { rec.onstop = res; rec.onerror = res; });
      rec.start();
      const total = seq.length * L.loops, t0 = performance.now();
      for (let n = 0; n < total; n++) {
        drawSheet(octx, seq[n % seq.length], W, H, gap);
        await sleep(Math.max(0, t0 + (n + 1) * 1000 / L.fps - performance.now()));
        if (token !== state.liveToken) { try { rec.stop(); } catch (e) { /* already stopped */ } return; }
      }
      rec.stop();
      await Promise.race([stopped, sleep(3000)]);
      if (token === state.liveToken && chunks.length) {
        state.liveBlob = new Blob(chunks, { type: type.split(';')[0] });
        state.liveExt = /mp4/.test(type) ? 'mp4' : 'webm';
      }
    } catch (e) { /* the static strip still exports on its own */ } finally { out.remove(); }
  }

  function takePhoto(idx) {
    const g = geometry(currentLayout(), CONFIG.strip.outputDpi);
    const v = video();
    const c = document.createElement('canvas');
    c.width = g.pw; c.height = g.ph;
    drawCover(c.getContext('2d'), v, v.videoWidth, v.videoHeight, 0, 0, g.pw, g.ph, CONFIG.camera.mirrorOutput, state.camZoom || 1);
    const f = $('flash'); f.classList.remove('go'); void f.offsetWidth; f.classList.add('go');
    setPhoto(idx, c);
  }

  function showCount(n) {
    const el = $('count');
    el.innerHTML = '';
    if (n == null) return;
    const s = document.createElement('span');
    s.className = 'count-num'; s.textContent = n;
    el.appendChild(s);
  }

  async function countdown(sec, onLast) {
    for (let n = sec; n >= 1; n--) {
      showCount(n);
      if (n === 1 && onLast) onLast();
      for (let t = 0; t < 1000; t += 100) {
        await sleep(100);
        if (state.cancel) { showCount(null); return false; }
      }
    }
    showCount(null);
    return true;
  }

  /** Auto-capture: runs the countdown + shot for each slot in turn, no extra clicks needed. */
  async function runSequence(indices) {
    if (state.running || state.camStatus !== 'ready') return;
    state.running = true; state.cancel = false;
    let live = null;
    try {
      for (const idx of indices) {
        state.activeSlot = idx;
        renderSlots(); updateCaptureUI();
        live = null;
        const ok = await countdown(state.delay, () => { live = startLive(); });   // clip starts 1s before the shutter
        if (!ok) { if (live) live.stop(); break; }
        takePhoto(idx);
        if (live) {
          await sleep(CONFIG.live.afterMs);
          const frames = live.stop(); live = null;
          const p = state.photos[idx];
          if (p && frames.length) p.frames = frames;
        } else await sleep(CONFIG.camera.pauseAfterShotMs);
      }
    } finally {
      if (live) live.stop();
      state.running = false; state.activeSlot = -1; state.cancel = false;
      showCount(null); renderSlots(); updateCaptureUI();
    }
  }

  /* Fallback when no camera is available: fill slots from the device's photos. */
  function pickFiles(targets, multiple) {
    const input = $('fileInput');
    state.pendingSlots = targets;
    input.multiple = !!multiple;
    input.value = '';
    input.click();
  }

  async function loadFileInto(file, idx) {
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      const g = geometry(currentLayout(), CONFIG.strip.outputDpi);
      const c = document.createElement('canvas');
      c.width = g.pw; c.height = g.ph;
      drawCover(c.getContext('2d'), img, img.naturalWidth, img.naturalHeight, 0, 0, g.pw, g.ph, false);
      setPhoto(idx, c);
    } catch (e) {
      toast(CONFIG.messages.renderError);
    } finally { URL.revokeObjectURL(url); }
  }

  async function onFilesChosen(e) {
    const files = Array.from(e.target.files || []);
    const targets = state.pendingSlots;
    for (let k = 0; k < Math.min(files.length, targets.length); k++) await loadFileInto(files[k], targets[k]);
  }

  const emptySlots = () => state.photos.map((p, i) => (p ? -1 : i)).filter((i) => i >= 0);
  const defaultTargets = () => { const e = emptySlots(); return e.length ? e : state.photos.map((_, i) => i); };

  function onCapture() {
    if (state.running) return;
    if (state.uploadMode) pickFiles(defaultTargets(), true);
    else runSequence(defaultTargets());
  }

  function redo(i) {
    if (state.running) return;
    if (state.uploadMode) pickFiles([i], false);
    else runSequence([i]);
  }

  function renderSlots() {
    const ol = $('slots');
    ol.innerHTML = '';
    state.photos.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'slot' + (p ? ' is-filled' : '') + (state.activeSlot === i ? ' is-active' : '');
      const fr = document.createElement('div');
      fr.className = 'slot-frame';
      if (p) {
        const img = document.createElement('img');
        img.src = p.thumb; img.alt = `Photo ${i + 1}`;
        fr.appendChild(img);
      } else fr.textContent = String(i + 1);
      li.appendChild(fr);
      if (p) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'redo'; b.disabled = state.running;
        b.setAttribute('aria-label', `Redo photo ${i + 1}`);
        b.innerHTML = '<svg class="icon" aria-hidden="true"><use href="#i-redo"/></svg><span>Redo</span>';
        b.addEventListener('click', () => redo(i));
        li.appendChild(b);
      }
      ol.appendChild(li);
    });
  }

  function updateCaptureUI() {
    const M = CONFIG.messages, total = currentLayout().count;
    const filled = state.photos.filter(Boolean).length;
    const allDone = filled === total;
    $('captureBtn').disabled = state.running || (!state.uploadMode && state.camStatus !== 'ready');
    $('captureBtnText').textContent = state.uploadMode ? CONFIG.text.captureUpload : CONFIG.text.capture;
    $('cancelBtn').hidden = !state.running;
    $('toEditBtn').hidden = !(allDone && !state.running);
    $('captureBack').disabled = state.running;
    let label;
    if (state.running && state.activeSlot >= 0) label = fmt(M.pose, { n: state.activeSlot + 1, total });
    else if (allDone) label = fmt(M.allDone, { total });
    else if (state.uploadMode) label = fmt(M.uploadReady, { total });
    else if (state.camStatus === 'loading') label = M.camLoading;
    else if (state.camStatus === 'ready') label = M.camReady;
    else label = '';
    $('poseLabel').textContent = label;
  }

  /* ======================================================================
     7. FILTERS + STRIP RENDERER
     ====================================================================== */
  const getFilter = (id) => CONFIG.filters.find((f) => f.id === id) || CONFIG.filters[0];

  /** Per-pixel look. Order: saturation, sepia, contrast/brightness, tints, faded blacks, grain, vignette. */
  function applyFilter(ctx, w, h, filter) {
    const p = filter.params || {};
    const img = ctx.getImageData(0, 0, w, h), d = img.data;
    const sat = p.sat != null ? p.sat : 1, sepia = p.sepia || 0, contrast = p.contrast != null ? p.contrast : 1;
    const bright = p.bright || 0, lift = p.lift || 0, grain = p.grain || 0, vig = p.vignette || 0;
    const shadow = p.shadow || [0, 0, 0], high = p.high || [0, 0, 0];
    const cx = w / 2, cy = h / 2, maxD = Math.hypot(cx, cy);
    let seed = 2463534242;
    const rnd = () => { seed = (seed ^ (seed << 13)) >>> 0; seed ^= seed >>> 17; seed = (seed ^ (seed << 5)) >>> 0; return seed / 4294967296; };
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = (y * w + x) * 4;
        let r = d[i], g = d[i + 1], b = d[i + 2];
        const lum = 0.299 * r + 0.587 * g + 0.114 * b;
        r = lum + (r - lum) * sat; g = lum + (g - lum) * sat; b = lum + (b - lum) * sat;
        if (sepia) {
          const sr = 0.393 * r + 0.769 * g + 0.189 * b, sg = 0.349 * r + 0.686 * g + 0.168 * b, sb = 0.272 * r + 0.534 * g + 0.131 * b;
          r += (sr - r) * sepia; g += (sg - g) * sepia; b += (sb - b) * sepia;
        }
        r = (r - 128) * contrast + 128 + bright; g = (g - 128) * contrast + 128 + bright; b = (b - 128) * contrast + 128 + bright;
        const t = Math.min(1, Math.max(0, (0.299 * r + 0.587 * g + 0.114 * b) / 255));
        r += shadow[0] * (1 - t) + high[0] * t; g += shadow[1] * (1 - t) + high[1] * t; b += shadow[2] * (1 - t) + high[2] * t;
        if (lift) { const k = lift / 255; r = r * (1 - k) + lift; g = g * (1 - k) + lift; b = b * (1 - k) + lift; }
        if (grain) { const n = (rnd() - 0.5) * grain * 2; r += n; g += n; b += n; }
        if (vig) { const dd = Math.hypot(x - cx, y - cy) / maxD; const v = 1 - vig * Math.max(0, dd - 0.35) / 0.65 * 1.2; r *= v; g *= v; b *= v; }
        d[i] = r < 0 ? 0 : r > 255 ? 255 : r; d[i + 1] = g < 0 ? 0 : g > 255 ? 255 : g; d[i + 2] = b < 0 ? 0 : b > 255 ? 255 : b;
      }
    }
    ctx.putImageData(img, 0, 0);
  }

  const filterCache = new Map();
  function filteredPhoto(photo, w, h, filter) {
    const key = `${photo.id}|${w}x${h}|${filter.id}`;
    if (filterCache.has(key)) return filterCache.get(key);
    const c = document.createElement('canvas');
    c.width = w; c.height = h;
    const ctx = c.getContext('2d');
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(photo.canvas, 0, 0, w, h);
    applyFilter(ctx, w, h, filter);
    if (filterCache.size > 40) filterCache.clear();
    filterCache.set(key, c);
    return c;
  }

