@keyframes tick {
  0%, 6% { transform: rotate(calc(var(--tick-angle) * -1)); }
  50%, 56% { transform: rotate(var(--tick-angle)); }
  100% { transform: rotate(calc(var(--tick-angle) * -1)); }
}
/* curtain hangs from its rod (top stays put); two slow, unequal rhythms so the breeze never looks mechanical */
