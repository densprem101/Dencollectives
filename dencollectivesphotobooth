    if (!tpl.noHeader) drawHeader(ctx, g, v, dpi, ink, accent);
    if (P) P.front(ctx, g, v, dpi, C);
    if (!tpl.art && !tpl.noFooter) drawFooter(ctx, g, tpl.ownDate ? Object.assign({}, v, { showDate: false }) : v, dpi, tpl.footOn === 'frame' ? C.pInk : ink, accent,
      g.bottomY + (tpl.deco === 'scallop' ? px(0.14) : tpl.paint ? px(0.04) : 0), g.H - px(tpl.band || 0));

    // stickers sit on top of everything
    v.stickers.forEach((st) => drawSticker(ctx, st, g.W, g.H));
  }

